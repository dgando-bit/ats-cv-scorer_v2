# ============================================================
# ATS CV Scorer
# Environment variables
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=ATS CV Scorer

# Modèle NER utilisé pour l'extraction du CV
MODEL_NAME=oksomu/resume-ner

# Taille maximale autorisée pour un CV PDF
MAX_FILE_SIZE_MB=10


# ------------------------------------------------------------
# France Travail API
# ------------------------------------------------------------

# Credentials disponibles depuis le portail France Travail
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Scope utilisé pour l'API Offres d'emploi v2
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre


# ------------------------------------------------------------
# Groq
# ------------------------------------------------------------

GROQ_API_KEY=

# Modèle utilisé pour les traitements LLM
GROQ_MODEL=openai/gpt-oss-20b


# ------------------------------------------------------------
# Hugging Face
# ------------------------------------------------------------

# Optionnel.
# Permet d'éviter les requêtes anonymes vers Hugging Face Hub
# et de bénéficier de limites plus élevées.
HF_TOKEN=
